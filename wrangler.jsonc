{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "robonautsclubbd",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Self-reference for revalidation (queue: "direct")
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "robonautsclubbd"
    }
  ],
  // R2 / DO queue cache disabled until R2 is enabled on this Cloudflare account.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "robonautsclub-app",
      "database_id": "51b286de-59ce-4059-8e04-24285b4525c9",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    // Cloudflare Worker preview URL — do not attach production DNS yet
    "NEXT_PUBLIC_BASE_URL": "https://robonautsclubbd.atm3collab.workers.dev",
    "NEXT_PUBLIC_SITE_URL": "https://robonautsclubbd.atm3collab.workers.dev",
    "BREVO_FROM_EMAIL": "no-reply@robonautsltd.com",
    "BKASH_CHECKOUT_URL_BASE": "https://tokenized.sandbox.bka.sh/v1.2.0-beta"
  },
  "secrets": {
    "required": [
      "AUTH_SECRET",
      "CLOUDINARY_URL",
      "BREVO_API_KEY",
      "SUPER_ADMIN_EMAILS",
      "BKASH_CHECKOUT_URL_APP_KEY",
      "BKASH_CHECKOUT_URL_APP_SECRET",
      "BKASH_CHECKOUT_URL_USER_NAME",
      "BKASH_CHECKOUT_URL_PASSWORD"
    ]
  },
  "observability": {
    "enabled": true
  }
}
