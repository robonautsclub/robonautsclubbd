{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "robonautsclubbd",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Self-reference required for ISR revalidation queue
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "robonautsclubbd"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "0cac87dac4aa4c0eb5216dddaa585a21"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "robonautsclub-next-tag-cache",
      "database_id": "98f68009-40ac-451f-9b3f-34d4f2f5d042"
    },
    {
      "binding": "DB",
      "database_name": "robonautsclub-app",
      "database_id": "51b286de-59ce-4059-8e04-24285b4525c9",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_BASE_URL": "https://robonautsclubbd.atm3collab.workers.dev",
    "NEXT_PUBLIC_SITE_URL": "https://robonautsclubbd.atm3collab.workers.dev",
    "BREVO_FROM_EMAIL": "no-reply@robonautsltd.com",
    "BKASH_CHECKOUT_URL_BASE": "https://tokenized.sandbox.bka.sh/v1.2.0-beta"
  },
  "secrets": {
    "required": [
      "AUTH_SECRET",
      "CLOUDINARY_URL",
      "BREVO_API_KEY",
      "SUPER_ADMIN_EMAILS",
      "BKASH_CHECKOUT_URL_APP_KEY",
      "BKASH_CHECKOUT_URL_APP_SECRET",
      "BKASH_CHECKOUT_URL_USER_NAME",
      "BKASH_CHECKOUT_URL_PASSWORD"
    ]
  },
  "observability": {
    "enabled": true
  }
}
